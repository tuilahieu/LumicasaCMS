---
import type { ContentEntry } from "emdash";
import { Image } from "emdash/ui";
import type { Service } from "../../../emdash-env";

interface Props {
	service: ContentEntry<Service>;
	index: number;
}

const { service, index } = Astro.props;
---

<article class="service-card">
	<div class="service-card__image" {...service.edit.image}>
		<Image image={service.data.image} />
	</div>
	<div class="service-card__body">
		<p class="eyebrow">{String(index + 1).padStart(2, "0")}</p>
		<h2 {...service.edit.title}>{service.data.title}</h2>
		<p {...service.edit.description}>{service.data.description}</p>
		{
			service.data.features && service.data.features.length > 0 && (
				<ul {...service.edit.features}>
					{service.data.features.map((feature) => <li>{feature.text}</li>)}
				</ul>
			)
		}
	</div>
</article>

<style>
	.service-card {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}

	.service-card__image {
		aspect-ratio: 16 / 9;
		margin: var(--space-3);
		overflow: hidden;
		border-radius: calc(var(--radius-md) - 0.45rem);
	}

	.service-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.service-card__body {
		display: grid;
		gap: var(--space-2);
		padding: 0 var(--space-4) var(--space-4);
	}

	.service-card h2 {
		font-size: var(--text-xl);
	}

	.service-card p:not(.eyebrow),
	.service-card li {
		color: var(--color-text-muted);
	}

	.service-card ul {
		margin: var(--space-2) 0 0;
		padding-left: 1.25rem;
	}
</style>
