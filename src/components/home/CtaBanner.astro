---
import Button from "../common/Button.astro";

interface Props {
	title: string;
	description?: string;
	label: string;
	url: string;
}

const { title, description, label, url } = Astro.props;
---

<section class="cta-banner" aria-labelledby="cta-banner-title">
	<div>
		<h2 id="cta-banner-title">{title}</h2>
		{description && <p>{description}</p>}
	</div>
	<Button href={url}>{label}</Button>
</section>

<style>
	.cta-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid rgb(84 219 199 / 25%);
		border-radius: var(--radius-lg);
		background: linear-gradient(120deg, rgb(84 219 199 / 22%), rgb(70 103 196 / 25%));
	}

	.cta-banner > div {
		display: grid;
		gap: var(--space-2);
	}

	.cta-banner h2 {
		font-size: clamp(1.75rem, 4vw, 3rem);
	}

	.cta-banner p {
		color: var(--color-text-muted);
	}

	@media (max-width: 700px) {
		.cta-banner {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
