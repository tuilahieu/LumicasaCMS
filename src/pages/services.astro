---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import EmptyState from "../components/common/EmptyState.astro";
import PageIntro from "../components/common/PageIntro.astro";
import ServiceCard from "../components/services/ServiceCard.astro";
import Base from "../layouts/Base.astro";
import "../css/pages/services.css";

const [introResult, servicesResult] = await Promise.all([
	getEmDashEntry("pages", "services"),
	getEmDashCollection("services", {
		status: "published",
		orderBy: { sort_order: "asc" },
		limit: 100,
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(introResult.cacheHint);
	Astro.cache.set(servicesResult.cacheHint);
}

const intro = introResult.entry;
const services = servicesResult.entries;
---

<Base title={intro?.data.title ?? "Dịch vụ"} description={intro?.data.description}>
	<div class="container page-shell services-page">
		{intro && <PageIntro page={intro} variables={{ countService: services.length }} />}

		{
			services.length > 0 ? (
				<div class="services-page__grid">
					{services.map((service, index) => <ServiceCard service={service} index={index} />)}
				</div>
			) : (
				<EmptyState title="Chưa có dịch vụ" description="Dịch vụ sẽ xuất hiện sau khi được publish trong EmDash Admin." />
			)
		}
	</div>
</Base>
