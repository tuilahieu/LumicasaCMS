{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumicasa",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumicasa",
      "database_id": "89fd67a2-a409-4bf6-961a-a9a58261484f",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lumicasa",
    },
  ],
  // Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
  // "worker_loaders": [{ "binding": "LOADER" }],
  // General maintenance cron trigger
  "triggers": {
    "crons": ["* * * * *"],
  },
}
